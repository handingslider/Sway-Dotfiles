# Logo key.
set $mod Mod4

font pango:GoogleSans, Regular, 10
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher
#set $menu wmenu-run
set $menu wofi --show drun
### Output configuration
output * bg wallpaper.jpg fill
### Idle configuration
exec swayidle -w \
          timeout 400 'swaylock -f -c 000000' \
          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
          before-sleep 'swaylock -f -c 000000'
### Input configuration
   input type:touchpad {
       dwt enabled
       tap enabled
       natural_scroll enabled
       middle_emulation enabled
   }

   input type:keyboard {
       xkb_layout "us, ua, ru"
       xkb_options "grp:win_space_toggle"
   }
   input type:mouse {
	accel_profile "flat"
   }
### Workspaces setup
set $workspace1 "1"
set $workspace2 "2"
set $workspace3 "3"
set $workspace4 "4"
set $workspace5 "5"
### Keybindings configuration saved in that file
include ~/.config/sway/keybindings
#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
set $bg-color 	         #2f343f
set $inactive-bg-color   #2f343f
set $text-color          #f3f4f5
set $inactive-text-color #676E7D
set $urgent-bg-color     #E53935

# window colors
#                       border              background         text                 indicator
client.focused          $bg-color           $bg-color          $text-color          #00ff00
client.unfocused        $inactive-bg-color $inactive-bg-color $inactive-text-color #00ff00
client.focused_inactive $inactive-bg-color $inactive-bg-color $inactive-text-color #00ff00
client.urgent           $urgent-bg-color    $urgent-bg-color   $text-color          #00ff00
hide_edge_borders both
bar {
	swaybar_command waybar
}

include /etc/sway/config.d/*
### Start of my config.

### Display configuration

### Some applets
exec {
	blueman-applet
	nm-applet
}
### Apps which will run at start of session
exec {
	$term
	firefox
	Telegram
	thunar
}

### Execute notification service at start of sway
exec_always mako


### Assign apps to workspaces $workspaceX defined at line 118
assign {
	[app_id="kitty"] $workspace1
	[app_id="firefox"] $workspace2
	[app_id="org.telegram.desktop"] $workspace3
	[app_id="thunar"] $workspace4
}

for_window {
	[app_id="blueman-manager"] floating enable
}
### nwd-displays support
include ~/.config/sway/outputs
include ~/.config/sway/workspaces
